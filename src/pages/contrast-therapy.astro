---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Video from '../components/Video.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { media } from '../data/site';
const steps = [
  {
    n: '01',
    title: 'Cold plunge',
    text: 'Cold-water immersion as part of your recovery session. Your practitioner will guide you through it at a pace that suits you.',
    image: media.plunge,
    alt: 'Water-filled plunge tub in the Synaptyx Manual Therapy recovery room',
  },
  {
    n: '02',
    title: 'Hot plunge',
    text: 'Warm-water immersion gives you time to unwind between activities. Ask the team how hot and cold fit together in your session.',
    image: media.facility,
    alt: 'The plunge tubs and treatment area in the Oakbrook Terrace recovery space',
  },
  {
    n: '03',
    title: 'Infrared sauna',
    text: 'The infrared sauna rounds out the space. Your practitioner will help you settle on temperature and time.',
    image: media.sauna,
    alt: 'Infrared sauna at Synaptyx Manual Therapy in Oakbrook Terrace',
  },
];
---

<BaseLayout
  title="Contrast Therapy in Oakbrook Terrace, IL | Synaptyx Manual Therapy"
  description="Explore the cold plunge, hot plunge, and infrared sauna at Synaptyx Manual Therapy, formerly Total Tissue & Fitness, in Oakbrook Terrace. Learn what to expect and arrange a contrast therapy session."
  image={media.socialContrastTherapy}
  imageAlt="Synaptyx Manual Therapy: Recover with intention. Come back ready. Cold plunge, hot plunge, and infrared sauna."
>
  <PageHero
    eyebrow="02 / CONTRAST THERAPY"
    title="Recover with intention."
    accent="Come back ready."
    description="Cold plunge. Hot plunge. Infrared sauna. Three experiences, brought together in a dedicated recovery space."
    image={media.plunge}
    imageAlt="Water-filled plunge tub in the Synaptyx Manual Therapy recovery room"
    ><a class="button" href={withBase('/book/#booking-widget')}>View booking options →</a></PageHero
  >
  <section class="container section-tight">
    <img
      class="wide-image"
      src={withBase(media.facility)}
      width="1798"
      height="1200"
      alt="The Oakbrook Terrace contrast therapy space with plunge tubs, treatment table, and infrared sauna"
      loading="lazy"
    />
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE EXPERIENCE</p><h2>
          A change of pace.<br /><span class="gradient-text">A space to reset.</span>
        </h2>
      </div><p>
        Contrast therapy is a core part of how we think about recovery. Your practitioner will walk
        you through how it fits your goals and whether it’s right for you.
      </p>
    </div><div class="image-card-grid snap-row">
      {
        steps.map((s) => (
          <article class="image-card">
            <>
              <div class="image-card-media">
                <img
                  src={withBase(s.image)}
                  width="1798"
                  height="1200"
                  loading="lazy"
                  alt={s.alt}
                />
                <span class="image-card-index" aria-hidden="true">
                  {s.n}/{String(steps.length).padStart(2, '0')}
                </span>
              </div>
              <div>
                <>
                  <p class="eyebrow">{s.n} / THE PROCESS</p>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="container section border-top split-section">
    <div>
      <p class="eyebrow">BEFORE YOUR SESSION</p><h2>Start with<br />the right guidance.</h2><p>
        When you arrange your visit, tell the team about any health conditions we should know about,
        and ask anything you like about preparation, session length, and what to bring.
      </p>
    </div><div>
      <Video id="gRatHeEvmPw" title="What is contrast therapy?" poster={media.sauna} /><p
        class="small-text"
      >
        This video was recorded when the practice operated as Total Tissue & Fitness.
      </p>
    </div>
  </section><FAQ /><CTA />
</BaseLayout>
