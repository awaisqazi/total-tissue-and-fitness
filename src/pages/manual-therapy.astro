---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Video from '../components/Video.astro';
import CTA from '../components/CTA.astro';
import { media, site } from '../data/site';
const techniques = [
  'Myotome testing',
  'Muscle pairing',
  'Neuromuscular activation therapy',
  'Fascial adhesion hydration / release',
  'Cupping',
  'Graston',
  'Body tempering',
  'Voodoo flossing',
  'Myofascial release',
  'Integration exercise',
];
---

<BaseLayout
  title="Manual Therapy in Oakbrook Terrace, IL | Synaptyx Manual Therapy"
  description="Explore personalized tissue work, biomechanical assessment, and movement education at Synaptyx Manual Therapy, formerly Total Tissue & Fitness, in Oakbrook Terrace, Illinois."
>
  <PageHero
    eyebrow="01 / MANUAL THERAPY"
    title="Understand your body."
    accent="Move with purpose."
    description="Hands-on tissue work and movement education, connected through an individual approach to recovery and training."
    image={media.facility}
    imageAlt="Synaptyx Manual Therapy recovery space in Oakbrook Terrace with plunge tubs and an infrared sauna"
    imageWidth={1600}
    imageHeight={1068}
    ><a class="button" href={withBase('/book/')}>Plan your first visit →</a></PageHero
  >
  <section class="container split-section section border-top">
    <div>
      <p class="eyebrow">OUR APPROACH</p><h2>More than<br />a single technique.</h2><p>
        We’ve always brought bodywork, biomechanics, and education together, first as Total Tissue &
        Fitness and now as Synaptyx Manual Therapy. Every session builds on that foundation.
      </p><p>
        Each session combines assessment, soft tissue techniques, and integration exercise. What
        your practitioner learns about how you move guides the hands-on work, and they’ll explain
        how it connects to your goals along the way.
      </p><a href={withBase('/contact/')} class="text-link">Ask about your goals →</a>
    </div><div class="feature-panel">
      <span class="feature-index">ASSESS → WORK → INTEGRATE</span><h3>
        Education is part<br />of the session.
      </h3><p>
        Understand the purpose of the work. Explore movement habits. Take that understanding into
        your training and everyday life.
      </p><Video
        id="uBjppA4WRW4"
        title="The approach, recorded as Total Tissue & Fitness"
        poster={media.poster}
      />
    </div>
  </section>
  <section class="section surface-section">
    <div class="container">
      <p class="eyebrow">THE TOOLKIT</p><h2>
        Different tools.<br /><span class="gradient-text">One individual approach.</span>
      </h2><p class="measure">
        These are the techniques we work with. Your practitioner will choose the ones that fit you
        and your session, and talk you through why.
      </p><div class="technique-grid">
        {
          techniques.map((t, i) => (
            <div>
              <>
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{t}</h3>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section container split-section">
    <img
      class="rounded-image"
      src={withBase(media.facility)}
      width="1798"
      height="1200"
      loading="lazy"
      alt="Synaptyx Manual Therapy recovery space in Oakbrook Terrace with plunge tubs and an infrared sauna"
    /><div>
      <p class="eyebrow">COMPLETE THE EXPERIENCE</p><h2>
        Tissue work.<br /><span class="gradient-text">Then time to recover.</span>
      </h2><p>
        Tissue-work sessions currently come with an hour of contrast therapy: cold plunge, hot tub,
        and infrared sauna. Check what’s included when you book.
      </p><a class="text-link" href={withBase('/contrast-therapy/')}>Explore contrast therapy →</a>
    </div>
  </section>
  <section class="section container border-top" id="our-story">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE NEXT CHAPTER</p><h2>
          Hands-on care.<br /><span class="gradient-text">Rooted in understanding.</span>
        </h2>
      </div><p>
        Synaptyx Manual Therapy carries the tissue-focused work and biomechanics of Total Tissue &
        Fitness forward as its own sister company within the Synaptyx family.
      </p>
    </div><div class="story-note">
      <img
        class="legacy-logo"
        src={withBase(media.legacyLogo)}
        width="2236"
        height="1176"
        loading="lazy"
        alt="Total Tissue & Fitness, the practice’s former name and logo"
      /><p>
        Formerly Total Tissue & Fitness. Our home is Oakbrook Terrace, Illinois, where we combine
        hands-on work, practical education, and contrast therapy in one recovery experience.
      </p><a class="text-link" href={site.partnerUrl} target="_blank" rel="noopener noreferrer"
        >Visit our sister company, {site.sisterName} ↗</a
      >
    </div>
  </section><CTA />
</BaseLayout>
