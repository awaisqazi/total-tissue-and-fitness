---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { booking, site } from '../data/site';
---

<BaseLayout
  title="Book Your Session | Synaptyx Manual Therapy"
  description="Book a Synaptyx Manual Therapy service with Josh or Casey or browse gift cards through Vagaro. First sessions require a call before booking. Formerly Total Tissue & Fitness."
>
  <PageHero
    eyebrow="YOUR NEXT STEP"
    title="Book with Josh"
    accent="or Casey."
    description="Choose from current services and appointment times in Vagaro. Gift cards are available there too."
  />
  <section class="booking-live" id="booking-widget" aria-labelledby="booking-heading">
    <div class="container booking-live-inner" id="returning-client">
      <div class="booking-live-heading">
        <div>
          <p class="eyebrow">LIVE BOOKING</p>
          <h2 id="booking-heading">Find a service, time, or gift card.</h2>
          <p>
            Choose Josh or Casey where available. Vagaro handles booking, checkout, and
            confirmation.
          </p>
        </div>
        <a class="text-link" href={booking.services} target="_blank" rel="noopener noreferrer"
          >Open Vagaro directly ↗</a
        >
      </div>

      <div class="booking-first-visit" id="first-visit">
        <h3>Before your first session</h3>
        <p>
          Vagaro asks new clients to schedule a call before booking a first session. Select the
          first-session listing in the widget for its current contact instructions, then book with
          Josh or Casey after the call. For help, call <a href={`tel:${site.phone}`}
            >{site.phoneDisplay}</a
          >.
        </p>
      </div>

      <div class="vagaro-widget-shell" set:html={booking.widgetHtml} />

      <div class="booking-after-widget">
        <p class="booking-help">
          If the widget does not load or you do not see the service you need, <a
            href={booking.services}
            target="_blank"
            rel="noopener noreferrer">open Vagaro directly</a
          > or call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
        </p>
        <p class="booking-location">
          <strong>Visit us in Oakbrook Terrace</strong><br />
          {site.address}. Check your Vagaro confirmation for the details of your visit.
        </p>
        <nav class="booking-more" aria-label="More about Synaptyx on Vagaro">
          <span>More about us on Vagaro:</span>
          <a href={booking.about} target="_blank" rel="noopener noreferrer">About ↗</a>
          <a href={booking.staff} target="_blank" rel="noopener noreferrer">Staff ↗</a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
