---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/paths';
import { booking, media, site } from '../data/site';
---

<BaseLayout
  title="Book Your Session | Synaptyx Manual Therapy"
  description="Book a Synaptyx Manual Therapy service with Josh or Casey or browse gift cards through Vagaro. First sessions require a call before booking. Formerly Total Tissue & Fitness."
  image={media.socialBook}
  imageAlt="Synaptyx Manual Therapy: Book with Josh or Casey. Live availability, gift cards, and first-visit details."
>
  <PageHero
    eyebrow="YOUR NEXT STEP"
    title="Book with Josh"
    accent="or Casey."
    description="Pick a service and a time that suits you. Gift cards are here too."
  />
  <section
    class="section container booking-section border-top"
    id="booking-widget"
    aria-labelledby="booking-heading"
  >
    <div id="returning-client">
      <div class="booking-intro">
        <div>
          <p class="eyebrow">LIVE BOOKING</p>
          <h2 id="booking-heading">Find a service, time, or gift card.</h2>
          <p>
            Choose Josh or Casey where available. Booking, checkout, and confirmation all happen
            right here through Vagaro.
          </p>
        </div>
        <a class="text-link" href={booking.services} target="_blank" rel="noopener noreferrer"
          >Open Vagaro directly ↗</a
        >
      </div>

      <div class="booking-first-visit" id="first-visit">
        <h3>Before your first session</h3>
        <p>
          New here? We start with a quick call. Open the first-session listing below for how to
          reach the team, then book with Josh or Casey once you’ve talked. Questions? Call <a
            href={`tel:${site.phone}`}>{site.phoneDisplay}</a
          >.
        </p>
      </div>

      <div class="vagaro-widget-card">
        <div class="panel-bar">
          <img src={withBase(media.logo)} alt="" width="49" height="28" loading="lazy" />
          <p class="eyebrow">SECURE ONLINE BOOKING</p>
        </div>
        <div class="vagaro-widget-body" set:html={booking.widgetHtml} />
      </div>

      <div class="booking-after-widget">
        <p class="booking-help">
          Don’t see what you’re looking for, or the widget won’t load? <a
            href={booking.services}
            target="_blank"
            rel="noopener noreferrer">open Vagaro directly</a
          > or call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
        </p>
        <p class="booking-location">
          <strong>Visit us in Oakbrook Terrace</strong><br />
          {site.address}. Your Vagaro confirmation has everything you need for your visit.
        </p>
        <nav class="booking-more" aria-label="More about Synaptyx on Vagaro">
          <span>More about us on Vagaro:</span>
          <a href={booking.about} target="_blank" rel="noopener noreferrer">About ↗</a>
          <a href={booking.staff} target="_blank" rel="noopener noreferrer">Staff ↗</a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
