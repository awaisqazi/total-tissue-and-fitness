---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { booking } from '../data/site';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="Book Your Session | Synaptyx Manual Therapy"
  description="Find the right booking pathway for new and returning clients, contrast therapy, and couples workshops at Synaptyx Manual Therapy, formerly Total Tissue & Fitness, in Oswego."
>
  <PageHero
    eyebrow="YOUR NEXT STEP"
    title="Let’s get you"
    accent="moving forward."
    description="Choose the pathway that fits you. Our team will help you understand what to expect and how to prepare."
  />
  <section class="container booking-notice">
    <span class="notice-icon" aria-hidden="true">i</span><div>
      <h2>We’re moving to Jane.</h2><p>
        New client appointments are manually scheduled after your free educational session. Existing
        clients will begin transitioning to Jane on <strong>November 1, 2026</strong>. Please follow
        the booking instructions given to you by the team.
      </p>
    </div>
  </section>
  <section class="section container booking-grid">
    <article class="booking-card">
      <p class="eyebrow">FIRST TIME HERE?</p><h2>New clients</h2><p>
        Start with a free educational session to discuss your goals and learn about the approach.
        The team will arrange your next appointment in Jane.
      </p><a class="button" href={withBase('/contact/?interest=new-client')}
        >Arrange your first conversation →</a
      >
    </article><article class="booking-card" id="returning-client">
      <p class="eyebrow">WELCOME BACK</p><h2>Returning clients</h2><p>
        Your existing profile helps the team follow your session history and progress. Use the
        current booking calendar while your account transitions.
      </p><a
        class="button button-outline"
        href={booking.returning}
        target="_blank"
        rel="noopener noreferrer">Returning client booking ↗</a
      >
    </article><article class="booking-card" id="contrast">
      <p class="eyebrow">RECOVERY TIME</p><h2>Contrast Therapy</h2><p>
        Arrange your first contrast therapy visit using the existing calendar. If you’re unsure
        which appointment to select, contact the team.
      </p><a
        class="button button-outline"
        href={booking.contrast}
        target="_blank"
        rel="noopener noreferrer">Contrast therapy calendar ↗</a
      >
    </article><article class="booking-card">
      <p class="eyebrow">LEARN TOGETHER</p><h2>Couples Workshop</h2><p>
        A practical, 3–4 hour workshop for two, with take-home tools. Ask the team to confirm
        current dates, pricing, and the correct booking pathway.
      </p><a class="button button-outline" href={withBase('/contact/?interest=couples')}
        >Preview a workshop inquiry →</a
      >
    </article>
  </section>
  <div class="container secondary-note">
    <a class="text-link" href={booking.services} target="_blank" rel="noopener noreferrer"
      >View the existing service calendar ↗</a
    ><p>
      Booking calendars open on external providers. If a calendar is unavailable, <a
        href={withBase('/contact/')}>get in touch</a
      > for help.
    </p>
  </div><CTA />
</BaseLayout>
