---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { contactForm } from '../data/contactForm';
---

<BaseLayout
  title="Contact & Inquiries | Synaptyx Manual Therapy"
  description="Explore your next step with Synaptyx Manual Therapy, formerly Total Tissue & Fitness, in Oakbrook Terrace. Ask about manual therapy, contrast therapy, couples workshops, and practitioner mentorship."
>
  <PageHero
    eyebrow="LET’S CONNECT"
    title="What moves you?"
    accent="Let’s start there."
    description="Explore a first visit, ask about our approach, or tell us what you’d like to learn."
  />
  <section class="section container contact-grid border-top">
    <div>
      <p class="eyebrow">SYNAPTYX MANUAL THERAPY · FORMERLY TOTAL TISSUE & FITNESS</p><h2>
        Hands-on care.<br /><span class="gradient-text">Here in Oakbrook Terrace.</span>
      </h2><p>
        Appointments are at {site.address}. Check your booking confirmation for arrival details.
      </p><div class="contact-resource">
        <span class="eyebrow">APPOINTMENTS</span><h3>Ready to plan a visit?</h3><p>
          Book with Josh or Casey in Vagaro. Follow the first-session contact instructions there
          before booking your first visit.
        </p><a class="text-link" href={withBase('/book/')}>View booking options →</a>
        <p>
          Need help? Call our business line at <a class="text-link" href={`tel:${site.phone}`}
            >{site.phoneDisplay}</a
          >.
        </p>
      </div><div class="contact-resource">
        <span class="eyebrow">PRACTITIONER EDUCATION</span><h3>Bring your experience.</h3><p>
          Learn about the mentorship program and the techniques covered.
        </p><a class="text-link" href={withBase('/mentorship-program/')}>Explore mentorship →</a>
      </div>
    </div>
    <div class="inquiry-panel">
      <h2>Start a conversation</h2><p>
        Send a general question to the Synaptyx Manual Therapy team. Please do not include medical
        or other sensitive health information. For appointments, use the booking options or call us.
      </p><form id="contact-form" action={contactForm.endpoint} method="post">
        <div class="form-row">
          <label
            >Your name<input
              name="name"
              autocomplete="name"
              maxlength="100"
              placeholder="First and last name"
              required
            /></label
          ><label
            >Email address<input
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            /></label
          >
        </div><label
          >I’m interested in<select name="interest" id="inquiry-interest" required
            ><option value="My first visit">My first visit</option><option value="Manual Therapy"
              >Manual Therapy</option
            ><option value="Contrast Therapy">Contrast Therapy</option><option
              value="Couples Workshop">Couples Workshop</option
            ><option value="Practitioner Mentorship">Practitioner Mentorship</option><option
              value="A general question">A general question</option
            ></select
          ></label
        ><label
          >Profession <span class="muted">(for mentorship inquiries)</span><input
            name="profession"
            maxlength="120"
            placeholder="Your area of practice"
          /></label
        ><label
          >Your message<textarea
            name="message"
            rows="5"
            required
            minlength="10"
            maxlength="2000"
            placeholder="How can we help? Please leave out medical or sensitive health details."
          ></textarea></label
        ><div
          class="cf-turnstile"
          data-sitekey={contactForm.siteKey}
          data-action="contact"
          data-theme="dark"
          data-size="flexible"
        >
        </div><p>
          We use the details you submit to respond to your inquiry. See our <a
            href={withBase('/privacy/')}>website privacy information</a
          >.
        </p><button type="submit" class="button" disabled={!contactForm.endpoint}
          >Send inquiry →</button
        >{
          !contactForm.endpoint && (
            <p class="form-status">
              The inquiry form is temporarily unavailable. Please call us instead.
            </p>
          )
        }<p id="inquiry-status" class="form-status" role="status" aria-live="polite" tabindex="-1">
        </p>
      </form>
      <noscript
        ><p>
          JavaScript is required to send an inquiry. Please call {site.phoneDisplay} instead.
        </p></noscript
      >
      <p>
        If the form does not respond, call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
      </p>
    </div>
  </section>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
  ></script>
  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const select = document.querySelector<HTMLSelectElement>('#inquiry-interest');
    const interest = new URLSearchParams(location.search).get('interest');
    const interestMap: Record<string, string> = {
      'new-client': 'My first visit',
      'manual-therapy': 'Manual Therapy',
      contrast: 'Contrast Therapy',
      couples: 'Couples Workshop',
      mentorship: 'Practitioner Mentorship',
      general: 'A general question',
    };
    if (select && interest && interestMap[interest]) select.value = interestMap[interest];
    const status = document.querySelector<HTMLElement>('#inquiry-status');
    const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
    if (form && status && submit) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        if (!data.get('cf-turnstile-response')) {
          status.textContent = 'Please complete the verification before sending.';
          status.focus();
          return;
        }
        if (!form.getAttribute('action')) {
          status.textContent = 'The contact form is unavailable. Please call us instead.';
          status.focus();
          return;
        }
        submit.disabled = true;
        status.textContent = 'Sending your inquiry…';
        try {
          const response = await fetch(form.action, { method: 'POST', body: data });
          if (!response.ok) throw new Error('Contact delivery failed');
          form.reset();
          status.textContent = 'Your inquiry was sent. Please call if you need help sooner.';
        } catch {
          status.textContent = 'We could not send your inquiry. Please try again or call us.';
        } finally {
          (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
          submit.disabled = false;
          status.focus();
        }
      });
    }
  </script>
</BaseLayout>
