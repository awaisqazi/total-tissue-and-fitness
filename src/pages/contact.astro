---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact & Inquiries | Total Tissue & Fitness"
  description="Explore your next step with Total Tissue & Fitness in Oswego. Ask about manual therapy, contrast therapy, couples workshops, and practitioner mentorship."
>
  <PageHero
    eyebrow="LET’S CONNECT"
    title="What moves you?"
    accent="Let’s start there."
    description="Explore a first visit, ask about our approach, or tell us what you’d like to learn."
  />
  <section class="section container contact-grid border-top">
    <div>
      <p class="eyebrow">TOTAL TISSUE & FITNESS</p><h2>
        Hands-on care.<br /><span class="gradient-text">Here in Oswego.</span>
      </h2><p>
        Our manual therapy and contrast therapy services are based in Oswego, Illinois. Confirm
        arrival details with the team when arranging your appointment.
      </p><div class="contact-resource">
        <span class="eyebrow">APPOINTMENTS</span><h3>Ready to plan a visit?</h3><p>
          Find the current booking links and information for new and returning clients.
        </p><a class="text-link" href={withBase('/book/')}>View booking options →</a>
      </div><div class="contact-resource">
        <span class="eyebrow">PRACTITIONER EDUCATION</span><h3>Bring your experience.</h3><p>
          Learn about the mentorship program and the techniques covered.
        </p><a class="text-link" href={withBase('/mentorship-program/')}>Explore mentorship →</a>
      </div>
    </div>
    <div class="inquiry-panel">
      <div class="demo-label">PROOF OF CONCEPT · FORM PREVIEW</div><h2>Start a conversation</h2><p>
        This previews the future inquiry experience. Messages are not sent or saved. Use the booking
        links for existing appointment options.
      </p><form id="inquiry-preview" method="dialog">
        <div class="form-row">
          <label
            >Your name<input
              name="name"
              autocomplete="name"
              maxlength="100"
              placeholder="First and last name"
              required
            /></label
          ><label
            >Email address<input
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            /></label
          >
        </div><label
          >I’m interested in<select name="interest" id="inquiry-interest" required
            ><option value="new-client">My first visit</option><option value="manual-therapy"
              >Manual therapy</option
            ><option value="contrast">Contrast therapy</option><option value="couples"
              >Couples workshop</option
            ><option value="mentorship">Practitioner mentorship</option><option value="general"
              >A general question</option
            ></select
          ></label
        ><label
          >Profession <span class="muted">(for mentorship inquiries)</span><input
            name="profession"
            maxlength="120"
            placeholder="Your area of practice"
          /></label
        ><label
          >Your message<textarea
            name="message"
            rows="5"
            required
            minlength="10"
            maxlength="2000"
            placeholder="For this demo, use a sample question rather than personal or health information."
          ></textarea></label
        ><button type="submit" class="button" disabled>Preview inquiry →</button><p
          id="inquiry-status"
          class="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
        >
        </p>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#inquiry-preview');
    const select = document.querySelector<HTMLSelectElement>('#inquiry-interest');
    const interest = new URLSearchParams(location.search).get('interest');
    if (select && interest && [...select.options].some((option) => option.value === interest))
      select.value = interest;
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const status = document.querySelector<HTMLElement>('#inquiry-status');
      if (status) {
        status.textContent =
          'Preview complete. Nothing was sent or saved. In the connected version, this inquiry would reach the team’s private dashboard.';
        status.focus();
      }
    });
    const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
    if (submit) submit.disabled = false;
  </script>
</BaseLayout>
