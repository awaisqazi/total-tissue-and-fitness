---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import { media, services, site } from '../data/site';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Video from '../components/Video.astro';
import { readdirSync } from 'node:fs';
const gallery = readdirSync('public/images').filter(
  (name) => name.startsWith('65f1fc8') && name.endsWith('.webp'),
);
const testimonials = [
  {
    name: 'John',
    quote: "The knowledge and professionalism... I'm dealing with someone who does their research",
  },
  { name: 'Mike', quote: 'It feels fantastic...It feels released, and overall feels better' },
];
---

<BaseLayout>
  <section class="hero">
    <img
      class="hero-image"
      src={withBase(media.facility)}
      width="1798"
      height="1200"
      alt=""
      fetchpriority="high"
    />
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase(media.poster)}
      aria-hidden="true"
      tabindex="-1"
      ><source src={withBase(media.heroLoopWebm)} type="video/webm" /><source
        src={withBase(media.heroLoopMp4)}
        type="video/mp4"
      /></video
    >
    <div class="hero-overlay"></div>
    <button class="hero-video-toggle" type="button" aria-pressed="true" hidden
      ><span class="toggle-icon" aria-hidden="true">❚❚</span><span class="toggle-label"
        >Pause video</span
      ></button
    >
    <div class="container hero-content">
      <p class="eyebrow pill">
        <span class="status-dot"></span> MANUAL THERAPY · MOVEMENT · RECOVERY
      </p>
      <h1>Move better.<br /><span class="gradient-text">Live fully.</span></h1>
      <p class="hero-description">
        A whole-body approach to feeling your best.<br />Hands-on tissue work, movement education,<br
          class="desktop-break"
        /> and purposeful recovery in Oakbrook Terrace, Illinois.
      </p>
      <div class="button-row">
        <a class="button" href={withBase('/book/')}
          >Start your recovery <span aria-hidden="true">→</span></a
        ><a class="button button-outline" href="#services"
          >Explore our approach <span aria-hidden="true">↓</span></a
        >
      </div>
      <div class="hero-facts">
        <div><strong>Hands-on</strong><span>PERSONALIZED CARE</span></div><div>
          <strong>Whole-body</strong><span>MOVEMENT & RECOVERY</span>
        </div><div><strong>Oakbrook Terrace, IL</strong><span>OUR HOME. YOUR COMMUNITY.</span></div>
      </div>
    </div>
    <div class="hero-caption">FORMERLY TOTAL TISSUE & FITNESS · OAKBROOK TERRACE, IL</div>
  </section>
  <div class="partnership-strip">
    <div class="container">
      <ol class="continuum" aria-label="How a session flows">
        {
          ['Assess', 'Work', 'Integrate', 'Recover'].map((step, i) => (
            <li>
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {step}
            </li>
          ))
        }
      </ol><a href={withBase('/manual-therapy/#our-story')}
        >Our approach <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
  <section class="section container transition-section" id="formerly">
    <div>
      <p class="eyebrow">A NEW NAME. THE SAME HANDS-ON APPROACH.</p><h2>
        Formerly<br /><span class="gradient-text">Total Tissue & Fitness.</span>
      </h2><p>
        {site.legacyName} is now {site.name}, a separate sister company within the Synaptyx family
        alongside {site.sisterName}. Everything you know us for, from the Oakbrook Terrace space to
        manual therapy, contrast therapy, and practitioner mentorship, continues under the Synaptyx
        name.
      </p><p>
        If you came here looking for Total Tissue & Fitness, you’re in the right place. Booking
        works the same way it always has.
      </p><div class="button-row">
        <a class="button button-outline" href={withBase('/book/')}>Booking options →</a><a
          class="text-link"
          href={site.partnerUrl}
          target="_blank"
          rel="noopener noreferrer">Our sister company, {site.sisterName} ↗</a
        >
      </div>
    </div><div class="identity-panel">
      <figure>
        <img
          class="legacy-logo"
          src={withBase(media.legacyLogo)}
          width="2236"
          height="1176"
          loading="lazy"
          alt="Total Tissue & Fitness gold logo"
        /><figcaption>Then · Total Tissue & Fitness</figcaption>
      </figure><span class="identity-arrow" aria-hidden="true">→</span><figure>
        <img
          src={withBase(media.logo)}
          width="672"
          height="386"
          loading="lazy"
          alt="Synaptyx mark"
        /><figcaption>Now · Synaptyx Manual Therapy</figcaption>
      </figure>
    </div>
  </section>
  <section class="section surface-section" id="services">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CARE THAT CONNECTS</p><h2>
            Your body.<br /><span class="gradient-text">The complete picture.</span>
          </h2>
        </div><p>
          Start with understanding how you move. Build on it with purposeful tissue work, practical
          education, and time to recover.
        </p>
      </div>
      <div class="service-grid snap-row">
        {
          services.map((service) => (
            <article class="service-card">
              <>
                <div class="service-media">
                  <img
                    src={withBase(service.image)}
                    alt=""
                    width="1200"
                    height="801"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="service-number">
                  {service.number}
                  <span aria-hidden="true">→</span>
                </span>
                <p class="eyebrow">{service.subtitle}</p>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <div class="tags">
                  {service.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <a class="text-link" href={withBase(service.href)}>
                  Explore {service.title.toLowerCase()} <span aria-hidden="true">→</span>
                </a>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split-section">
      <div>
        <p class="eyebrow">THE SYNAPTYX APPROACH</p><h2>
          Understand.<br />Restore.<br /><span class="gradient-text">Keep moving.</span>
        </h2><p>
          Recovery is more than time away from training. We connect hands-on tissue work with an
          understanding of how your body moves, so every session has a purpose.
        </p><a class="text-link" href={withBase('/manual-therapy/')}>Get to know our approach →</a>
      </div><div>
        <video
          class="facility-video"
          controls
          playsinline
          preload="none"
          poster={withBase(media.poster)}
          aria-label="A tour of the Synaptyx Manual Therapy facility in Oakbrook Terrace"
          ><source src={withBase(media.overview)} type="video/mp4" /><source
            src={withBase(media.overviewWebm)}
            type="video/webm"
          /><p>
            Your browser does not support this video. <a href={withBase(media.overview)}
              >Download the facility tour</a
            >.
          </p></video
        ><Video
          id="uBjppA4WRW4"
          title="This is Total Tissue & Fitness (now Synaptyx Manual Therapy)"
          poster={media.facility}
        />
      </div>
    </div>
  </section>
  <section class="section surface-section">
    <div class="container split-section">
      <div class="recovery-image">
        <img
          src={withBase(media.sauna)}
          width="1798"
          height="1200"
          alt="Infrared sauna in the Synaptyx Manual Therapy recovery space in Oakbrook Terrace"
          loading="lazy"
        /><div>
          <span class="eyebrow">RECOVERY, BUILT IN</span><strong
            >One hour.<br />Time for you.</strong
          >
        </div>
      </div><div>
        <p class="eyebrow">BEYOND THE TISSUE WORK</p><h2>
          Make recovery<br /><span class="gradient-text">part of the routine.</span>
        </h2><p>
          Complete your tissue session with an hour of contrast therapy. Our Oakbrook Terrace space
          brings together a cold plunge, hot tub, and infrared sauna.
        </p><div class="tags">
          <span>Cold plunge</span><span>Hot plunge</span><span>Infrared sauna</span>
        </div><a class="button button-outline" href={withBase('/contrast-therapy/')}
          >Explore the recovery space →</a
        >
      </div>
    </div>
  </section>
  <section class="section" id="free-offer">
    <div class="container split-section">
      <div>
        <p class="eyebrow">THE COUPLES WORKSHOP</p><h2>
          Train together.<br /><span class="gradient-text">Recover together.</span>
        </h2><p>
          Learn how to take care of each other with hands-on instruction and a toolkit to take home.
          A 3–4 hour workshop for couples who take their fitness and recovery seriously.
        </p><a class="button" href={withBase('/couples-workshop/')}>Discover the workshop →</a>
      </div><div class="workshop-feature">
        <span class="eyebrow">MORE THAN A SESSION</span><h3>
          Practical knowledge.<br />A shared toolkit.<br /><span class="gradient-text"
            >Yours to keep.</span
          >
        </h3><div class="tags">
          <span>Massage table</span><span>Cupping set</span><span>Graston tools</span><span
            >Floss bands</span
          ><span>A variety of hand tools</span>
        </div><Video
          id="nKuis2o6GUI"
          title="Hands-on workshop education"
          poster={media.mentorshipPoster}
        />
      </div>
    </div>
  </section>
  <section class="section surface-section" id="testimonial">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CLIENT STORIES</p><h2>
            Real people.<br /><span class="gradient-text">Their own words.</span>
          </h2>
        </div><p>
          Shared by clients during our years as Total Tissue & Fitness. Everyone’s experience is
          their own.
        </p>
      </div><div class="testimonial-grid snap-row">
        {
          testimonials.map((t) => (
            <figure class="story-card">
              <>
                <span class="quote-mark" aria-hidden="true">
                  “
                </span>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <span class="avatar" aria-hidden="true">
                    {t.name[0]}
                  </span>
                  <span class="story-name">{t.name}</span>
                  <span class="label-tag">Total Tissue client</span>
                </figcaption>
              </>
            </figure>
          ))
        }<div class="story-video">
          <p class="eyebrow">Hear it from Mike</p><Video
            id="KmQdSmb7iec"
            title="Hear it from Mike"
            poster={media.poster}
          />
        </div>
      </div><details class="gallery-disclosure">
        <summary
          >More client stories from the Total Tissue & Fitness years <span aria-hidden="true"
            >+</span
          ></summary
        ><div class="testimonial-gallery">
          {
            gallery.map((image, i) => (
              <a
                href={withBase('/images/' + image)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open original client testimonial image ${i + 1}`}
              >
                <img
                  src={withBase('/images/' + image)}
                  width="1200"
                  height="2004"
                  loading="lazy"
                  alt={`Original Total Tissue client testimonial, image ${i + 1}. Open for full size.`}
                />
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </section>
  <section class="container returning-strip" id="returning-client">
    <div>
      <p class="eyebrow">WELCOME BACK</p><h2>Already part of the community?</h2><p>
        See Josh and Casey’s live availability and grab a time that works for you. New here? Give us
        a call first.
      </p>
    </div><a class="button button-outline" href={withBase('/book/#returning-client')}
      >Returning client booking →</a
    >
  </section><FAQ /><CTA /><script src="../scripts/hero-video.ts"></script>
</BaseLayout>
