---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { media, site } from '../data/site';
---

<BaseLayout
  title="Couples Recovery Workshop | Synaptyx Manual Therapy"
  description="Learn practical recovery techniques together in the Synaptyx Manual Therapy couples workshop. A 3–4 hour hands-on session with take-home tools, in Oakbrook Terrace, Illinois."
>
  <PageHero
    eyebrow="LEARN TOGETHER"
    title="Better recovery."
    accent="Together."
    description="For partners who train hard, take recovery seriously, and want to learn how to take care of each other."
    image={media.sauna}
    imageAlt="Infrared sauna in the Synaptyx Manual Therapy recovery space in Oakbrook Terrace"
    ><a class="button" href={`tel:${site.phone}`}>Call about the workshop →</a></PageHero
  >
  <section class="section container split-section border-top">
    <div>
      <p class="eyebrow">COUPLES WORKSHOP</p><h2>
        Skills that stay<br /><span class="gradient-text">with you.</span>
      </h2><p>
        Learn how and when to use a range of recovery tools in a practical, hands-on session. Take
        the tools home and keep building on what you learn together.
      </p><p>
        It’s made for fitness-minded couples who want to understand each other’s recovery and be
        able to help.
      </p><a class="text-link" href={`tel:${site.phone}`}
        >Call {site.phoneDisplay} about the workshop →</a
      >
    </div><div class="feature-panel">
      <p class="eyebrow">THE CURRENT WORKSHOP OFFERING</p><div class="price">
        $1,200 <span>per couple</span>
      </div><p>3–4 hours · Take-home equipment included</p><ul class="check-list">
        <li>Massage table</li><li>Cupping set</li><li>Graston tools</li><li>Floss bands</li><li>
          A variety of hand tools
        </li><li>Instruction on how and when to use them</li>
      </ul><p class="small-text">
        Give us a call to confirm pricing, the equipment package, and availability before booking.
      </p><a class="button" href={`tel:${site.phone}`}>Call to discuss availability →</a>
    </div>
  </section><CTA />
</BaseLayout>
