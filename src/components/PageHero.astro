---
import { withBase } from '../lib/paths';
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
}
const { eyebrow, title, accent, description } = Astro.props;
---

<section class="page-hero container">
  <a href={withBase('/')} class="back-link">← Synaptyx Manual Therapy</a><p class="eyebrow">
    {eyebrow}
  </p><h1>
    {title}{
      accent && (
        <>
          <>
            <br />
            <span class="gradient-text">{accent}</span>
          </>
        </>
      )
    }
  </h1><p class="page-lead">{description}</p><slot />
</section>
