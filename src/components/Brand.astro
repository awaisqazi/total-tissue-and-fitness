---
import { withBase } from '../lib/paths';
import { media, site } from '../data/site';
---

<a href={withBase('/')} class="brand" aria-label={`${site.name} home`}
  ><img
    class="brand-mark"
    src={withBase(media.logo)}
    width="672"
    height="386"
    alt=""
    fetchpriority="high"
  /><span class="brand-text"
    ><span class="brand-name">SYNAPTYX</span><span class="brand-subtitle">Manual Therapy</span
    ></span
  ></a
>
