---
import { faqs } from '../data/site';
---

<section class="section container faq-section" id="faq">
  <div>
    <p class="eyebrow">GOOD TO KNOW</p><h2>
      A little clarity.<br /><span class="gradient-text">Before you begin.</span>
    </h2><p>Have something else on your mind?</p><a class="text-link" href="/contact/"
      >Talk with our team ↗</a>
  </div><div class="faq-list">
    {
      faqs.map((faq) => (
        <details>
          <>
            <summary>
              {faq.question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{faq.answer}</p>
          </>
        </details>
      ))
    }
  </div>
</section>
