---
import { withBase } from '../lib/paths';
import Brand from './Brand.astro';
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-top">
    <div>
      <Brand /><p>
        Hands-on care. Purposeful movement.<br />A more complete approach to recovery.
      </p><span class="muted small-text">Formerly {site.legacyName} · Oswego, Illinois</span>
    </div>
    <div>
      <h2>Explore</h2><a href={withBase('/manual-therapy/')}>Manual Therapy</a><a
        href={withBase('/contrast-therapy/')}>Contrast Therapy</a
      ><a href={withBase('/couples-workshop/')}>Couples Workshop</a><a
        href={withBase('/mentorship-program/')}>Practitioner Mentorship</a
      >
    </div>
    <div>
      <h2>Your next step</h2><a href={withBase('/book/')}>Book a Session</a><a
        href={withBase('/contact/')}>Get in Touch</a
      ><a href={withBase('/#faq')}>FAQs</a><a
        href={site.partnerUrl}
        target="_blank"
        rel="noopener noreferrer">{site.sisterName} (sister company) ↗</a
      >
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.name} · formerly {site.legacyName}</span><div>
      <a href={withBase('/privacy/')}>Privacy</a><a href={withBase('/admin/')}>Dashboard concept</a>
    </div>
  </div>
</footer>
