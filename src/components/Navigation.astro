---
import Brand from './Brand.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/manual-therapy/', label: 'Manual Therapy' },
  { href: '/contrast-therapy/', label: 'Contrast Therapy' },
  { href: '/mentorship-program/', label: 'Education' },
  { href: '/#testimonial', label: 'Client Stories' },
];
---

<header class="site-header">
  <div class="container nav-row">
    <Brand />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="button button-small desktop-book" href="/book/"
      >Book a session <span aria-hidden="true">↗</span></a
    >
    <details class="mobile-menu">
      <summary aria-label="Open navigation"
        ><span>Menu</span><span aria-hidden="true">☰</span></summary
      >
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}<a href="/couples-workshop/"
          >Couples Workshop</a
        ><a href="/contact/">Contact</a><a href="/book/">Book a session ↗</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      menu.open = false;
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
