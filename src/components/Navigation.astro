---
import { withBase } from '../lib/paths';
import Brand from './Brand.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/manual-therapy/', label: 'Manual Therapy' },
  { href: '/contrast-therapy/', label: 'Contrast Therapy' },
  { href: '/mentorship-program/', label: 'Education' },
  { href: '/#testimonial', label: 'Client Stories' },
];
---

<header class="site-header">
  <div class="container nav-row">
    <Brand />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={path === withBase(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="button button-small desktop-book" href={withBase('/book/')}
      >Book a session <span aria-hidden="true">↗</span></a
    >
    <details class="mobile-menu">
      <summary aria-label="Open navigation"
        ><span>Menu</span><span aria-hidden="true">☰</span></summary
      >
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a href={withBase(link.href)}>{link.label}</a>)}<a
          href={withBase('/couples-workshop/')}>Couples Workshop</a
        ><a href={withBase('/contact/')}>Contact</a><a href={withBase('/book/')}>Book a session ↗</a
        >
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      menu.open = false;
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
