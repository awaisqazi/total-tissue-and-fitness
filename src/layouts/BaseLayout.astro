---
import { withBase } from '../lib/paths';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { site, media } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = site.name + ' | Manual & Contrast Therapy in Oswego, IL',
  description = site.description,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isPublic = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !noindex;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><meta
      name="robots"
      content={isPublic ? 'index, follow' : 'noindex, nofollow'}
    />
    <meta name="theme-color" content="#0b0f13" />
    <meta property="og:type" content="website" /><meta
      property="og:site_name"
      content={site.name}
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={new URL(withBase(media.social), Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={new URL(withBase(media.social), Astro.site)}
    />
    <link rel="icon" type="image/png" href={withBase(media.favicon)} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: site.name,
        alternateName: site.legacyName,
        url: new URL(withBase('/'), Astro.site).href,
        description,
        areaServed: { '@type': 'City', name: 'Oswego, Illinois' },
      }).replace(/</g, '\\u003c')}
    />
  </head>
  <body
    ><a class="skip-link" href="#main">Skip to content</a><Navigation /><main id="main">
      <slot />
    </main><Footer /></body
  >
</html>
