{
  "name": "total-tissue-and-fitness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm run build && npm run check:links && npm test",
    "images:optimize": "node scripts/optimize-images.mjs",
    "check:links": "node scripts/check-built-site.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.{json,md,mjs}\" \"docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.{json,md,mjs}\" \"docs/*.md\""
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource/inter": "5.3.0",
    "astro": "7.3.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.4"
  }
}
